<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.zotero-nomad-import</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/USERNAME/.local/bin/uv</string>
        <string>run</string>
        <string>--quiet</string>
        <string>--script</string>
        <string>/Users/USERNAME/zotero-nomad/nomada</string>
        <string>pull</string>
    </array>

    <!-- Fire when something lands in EXPORT (mirror-mode Drive emits FS events) -->
    <key>WatchPaths</key>
    <array>
        <string>/Users/USERNAME/Library/CloudStorage/GoogleDrive-you@gmail.com/My Drive/SuperNote/EXPORT</string>
    </array>

    <!-- Safety net in case a sync event is missed -->
    <key>StartInterval</key>
    <integer>300</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/USERNAME/.local/state/nomada/import.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/USERNAME/.local/state/nomada/import.err.log</string>
</dict>
</plist>
