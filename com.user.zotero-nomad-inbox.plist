<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.zotero-nomad-inbox</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/USERNAME/.local/bin/uv</string>
        <string>run</string>
        <string>--quiet</string>
        <string>--script</string>
        <string>/Users/USERNAME/zotero-nomad/nomada</string>
        <string>push</string>
    </array>

    <key>StartInterval</key>
    <integer>180</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/USERNAME/.local/state/nomada/inbox.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/USERNAME/.local/state/nomada/inbox.err.log</string>
</dict>
</plist>
