NOTE_TEMPLATE = """\
---
title:      "{{note_title}}"
date:       {{date}}
tags:       {{tags}}
identifier: "{{identifier}}"
signature:  refs
citekey:    "{{citekey}}"
zotero:     "{{zotero_link}}"
---

# {{note_title}}

{{authors}} ({{year}})

## Summary

## Annotations

{{annotations}}
"""

PLACEHOLDER = re.compile(r"\{\{\s*(\w+)\s*\}\}")
PLACEHOLDERS = (
    "title", "note_title", "authors", "first_author", "year", "date", "identifier", "tags", "citekey",
    "doi", "url", "zotero_key", "zotero_link", "today", "annotations",
)
SUPERNOTE_INK = "Supernote_Bitmap"  # /Name of the stamp that holds the Nomad's handwriting
INK_GAP_PT = 24  # marks closer than this go into the same image
INK_PAD_PT = 36  # page kept around each group of marks, to crop later by hand
# Okabe-Ito blue: it stands out from gray for the common kinds of color blindness too.
INK_COLOR = (0, 114, 178)
IMAGE_DPI = 150
DENOTE_ID = re.compile(r"\d{8}T\d{6}")
# Embeds of the images `write_note` makes, e.g.
# ![[20210301T090001==refs--kanerva-2021-robust-vectors-annotation-p1-1.png]]
ANNOTATION_EMBED = re.compile(r"!\[\[(\d{8}T\d{6}[^\]|/]*-annotation-p\d+-\d+(?:__[^\]|/]*)?\.png)(?:\|[^\]]*)?\]\]")


class NoteError(Exception):
    pass


def load_template(cfg: Config) -> str:
    if not cfg.note_template:
        return NOTE_TEMPLATE
    path = Path(cfg.note_template).expanduser()
    try:
        template = path.read_text()
    except OSError as e:
        raise click.ClickException(f"can't read note template {path}: {e}")
    unknown = sorted(set(PLACEHOLDER.findall(template)) - set(PLACEHOLDERS))
    if unknown:
        raise click.ClickException(
            f"note template {path} uses unknown placeholder(s) {', '.join(unknown)}; "
            f"known ones are {', '.join(PLACEHOLDERS)}"
        )
    # A paper's note is found by this link, so every note must carry it.
    if "zotero_link" not in PLACEHOLDER.findall(front_matter(template)):
        raise click.ClickException(f"note template {path} must have {{{{zotero_link}}}} in its front matter")
    return template


def render_template(template: str, fields: dict[str, str]) -> str:
    return PLACEHOLDER.sub(lambda m: fields[m.group(1)], template)


def slugify(text: str) -> str:
    """Lowercase `text` and join its runs of letters and digits with hyphens, as Denote does."""
    return "-".join(re.findall(r"[^\W_]+", text.lower()))


def paper_fields(item: dict) -> dict[str, str]:
    """Metadata placeholders for the Zotero item `item`, as returned by the API."""
    key, data = item["key"], item["data"]
    title = (data.get("title") or "").strip()
    if not title:
        raise NoteError(f"item {key} has no title")
    parsed = (item.get("meta") or {}).get("parsedDate") or ""
    m = re.fullmatch(r"(\d{4})(?:-(\d{2}))?(?:-(\d{2}))?", parsed)
    if not m:
        raise NoteError(f"item {key} has no parseable date ({data.get('date')!r}); set its Date field in Zotero")
    year = m.group(1)
    month, day = (g if g and g != "00" else "01" for g in m.group(2, 3))

    names = [
        c.get("lastName") or c.get("name") or ""
        for c in data.get("creators", [])
        if c.get("creatorType") == "author"
    ]
    names = [n for n in names if n]
    if not names:
        raise NoteError(f"item {key} has no authors")
    citekey = data.get("citationKey") or ""
    if not citekey:
        found = re.search(r"^Citation Key:\s*(\S+)", data.get("extra") or "", re.MULTILINE)
        citekey = found.group(1) if found else ""
    return {
        "title": title,
        "note_title": f"{names[0]}, {year} - {title}",
        "authors": ", ".join(names),
        "first_author": names[0],
        "year": year,
        "date": f"{year}-{month}-{day}",
        "citekey": citekey,
        "doi": data.get("DOI") or "",
        "url": data.get("url") or "",
        "zotero_key": key,
        "zotero_link": f"zotero://select/library/items/{key}",
        "today": datetime.now().strftime("%Y-%m-%d"),
    }


def denote_keywords(item: dict, exclude: tuple[str, ...]) -> list[str]:
    """The item's manual Zotero tags, other than `exclude`, as sorted Denote keywords.

    Automatic tags (type 1), such as the subjects that imports add, are left
    out. A keyword is its tag lowercased, with only its letters and digits.
    """
    tags = [t["tag"] for t in item["data"].get("tags", []) if not t.get("type") and t["tag"] not in exclude]
    return sorted({k for t in tags if (k := "".join(re.findall(r"[^\W_]+", t.lower())))})


def note_slug(fields: dict[str, str]) -> str:
    return slugify(f"{fields['first_author']} {fields['year']} {fields['title']}")


def front_matter(text: str) -> str:
    """The YAML front matter at the start of the Markdown `text`, or "" if it has none."""
    m = re.match(r"---\n(.*?\n)---(?:\n|$)", text, re.DOTALL)
    return m.group(1) if m else ""


def find_note(notes_dir: Path, key: str) -> Path | None:
    """The note whose front matter links to Zotero item `key`, whatever its filename."""
    link = re.compile(rf"zotero://select/library/items/{re.escape(key)}\b")
    found = [p for p in sorted(notes_dir.glob("*.md")) if link.search(front_matter(p.read_text(errors="replace")))]
    if len(found) > 1:
        raise NoteError(f"several notes link to item {key}: {', '.join(p.name for p in found)}")
    return found[0] if found else None


def taken_identifiers(*dirs: Path) -> set[str]:
    """The Denote identifiers that start the names of files in `dirs`."""
    return {m.group() for d in dirs if d.is_dir() for f in d.iterdir() if (m := DENOTE_ID.match(f.name))}


def free_identifiers(start: datetime, count: int, taken: set[str]) -> list[str]:
    """The first `count` identifiers from `start` on, one second apart, that are not in `taken`."""
    found = []
    while len(found) < count:
        identifier = start.strftime("%Y%m%dT%H%M%S")
        if identifier not in taken:
            found.append(identifier)
        start += timedelta(seconds=1)
    return found


def annotation_name(note: Path, identifier: str, page: int, n: int) -> str:
    """The name of image `n` of page `page` of `note`: the note's name with
    `identifier` in place of its own and `-annotation-p<page>-<n>` ending the
    title, before any `__keywords`."""
    rest = DENOTE_ID.sub("", note.stem, count=1)
    title, sep, keywords = rest.partition("__")
    return f"{identifier}{title}-annotation-p{page}-{n}{sep}{keywords}.png"


def highlighted_text(page, v: list) -> str:
    """The words whose centers lie inside the quads with vertices `v` of a highlight on `page`."""
    import pymupdf

    quads = [pymupdf.Quad(v[i:i + 4]).rect for i in range(0, len(v) - 3, 4)]
    words = [
        w[4] for w in page.get_text("words")
        if any(q.contains(((w[0] + w[2]) / 2, (w[1] + w[3]) / 2)) for q in quads)
    ]
    text = ""
    for w in words:
        # A word broken across lines ends in a hyphen; rejoin it unless the
        # next part starts with a capital, as in "SMILES-PE".
        if text.endswith("-") and w[:1].islower():
            text = text[:-1] + w
        elif text.endswith("-"):
            text += w
        else:
            text += (" " if text else "") + w
    return text


def ink_boxes(mask, gap: int) -> list[tuple[int, int, int, int]]:
    """Boxes (x0, y0, x1, y1), inclusive, around groups of True pixels in the 2-D `mask`.

    Rows with ink are split into bands at gaps of more than `gap` empty rows,
    each band into columns the same way, and each column again into rows.
    """
    def runs(flags):
        idx = flags.nonzero()[0]
        if not len(idx):
            return []
        breaks = (idx[1:] - idx[:-1] > gap).nonzero()[0]
        starts = [idx[0], *idx[breaks + 1]]
        ends = [*idx[breaks], idx[-1]]
        return list(zip(starts, ends))

    boxes = []
    for r0, r1 in runs(mask.any(axis=1)):
        band = mask[r0:r1 + 1]
        for c0, c1 in runs(band.any(axis=0)):
            for s0, s1 in runs(band[:, c0:c1 + 1].any(axis=1)):
                boxes.append((int(c0), int(r0 + s0), int(c1), int(r0 + s1)))
    return boxes


def handwriting_images(path: Path) -> list[tuple[int, tuple[float, float, float, float], bytes]]:
    """Images (page number, box, PNG), one per group of handwritten marks in the export `path`.

    The Nomad stores a page's handwriting as one full-page stamp. The marks are
    the pixels that change when the stamp is drawn. Each image shows one group
    of marks in INK_COLOR and INK_PAD_PT of the page around it, without
    highlights and in grayscale, so other marks nearby show in gray. The box
    (x0, y0, x1, y1), in points, bounds the group.
    """
    import numpy as np
    import pymupdf

    def pixels(page, annots):
        pix = page.get_pixmap(dpi=IMAGE_DPI, annots=annots, alpha=False)
        return np.frombuffer(pix.samples, np.uint8).reshape(pix.h, pix.w, pix.n).astype(np.int16)

    scale = IMAGE_DPI / 72
    images = []
    # Pages lose their other annotations, in memory only.
    with pymupdf.open(path) as doc:
        for page in doc:
            annots = list(page.annots())
            if not any(a.type[1] == "Stamp" and a.info["name"] == SUPERNOTE_INK for a in annots):
                continue
            if page.rotation:
                raise NoteError(f"page {page.number + 1} is rotated, which handwriting extraction does not support")
            for xref in [a.xref for a in annots if a.info["name"] != SUPERNOTE_INK]:
                page.delete_annot(page.load_annot(xref))
            color = pixels(page, True)
            mask = abs(color - pixels(page, False)).max(axis=2) > 32
            gray = (color @ np.array([0.299, 0.587, 0.114])).round()  # ITU-R BT.601 luma
            gray = np.repeat(gray[:, :, None], 3, axis=2)
            # Solid, so ink that is light gray to begin with stands out too.
            tinted = np.array(INK_COLOR)
            # ink_boxes returns disjoint boxes, so each holds only its own group's marks.
            for x0, y0, x1, y1 in ink_boxes(mask, round(INK_GAP_PT * scale)):
                group = np.zeros_like(mask)
                group[y0:y1 + 1, x0:x1 + 1] = mask[y0:y1 + 1, x0:x1 + 1]
                out = np.where(group[:, :, None], tinted, gray).astype(np.uint8)
                pad = round(INK_PAD_PT * scale)
                out = np.ascontiguousarray(out[max(y0 - pad, 0):y1 + 1 + pad, max(x0 - pad, 0):x1 + 1 + pad])
                pix = pymupdf.Pixmap(pymupdf.csRGB, out.shape[1], out.shape[0], out.tobytes(), False)
                box = (x0 / scale, y0 / scale, (x1 + 1) / scale, (y1 + 1) / scale)
                images.append((page.number + 1, box, pix.tobytes("png")))
    return images


def text_flow(page) -> list[tuple[tuple, list[tuple]]]:
    """The text blocks of `page` as (box, line boxes), in the order the PDF
    stores them, which in typeset papers is reading order."""
    blocks = page.get_text("dict", sort=False)["blocks"]
    return [(b["bbox"], [line["bbox"] for line in b["lines"]]) for b in blocks if b["type"] == 0]


def flow_position(flow: list[tuple[tuple, list[tuple]]], x: float, y: float) -> tuple[float, float]:
    """Where the point (x, y) falls in the text `flow` of its page: (block, line).

    The block is the one nearest the point; the line is that block's last
    line starting at or above `y`, or its first. A note written in the margin
    gets the line beside it. A page without text orders points by `y`.
    """
    if not flow:
        return 0, y

    def distance(box):
        return math.hypot(max(box[0] - x, x - box[2], 0), max(box[1] - y, y - box[3], 0))

    block = min(range(len(flow)), key=lambda i: distance(flow[i][0]))
    lines = flow[block][1]
    return block, max((i for i, box in enumerate(lines) if box[1] <= y), default=0)


def read_annotations(job: str, path: Path) -> list[tuple[int, str | bytes]]:
    """The highlighted text and handwriting images (PNG) of the export `path`,
    as (page, content), in the order of the text they are on.

    A highlight is placed at the line where it starts, an image at the line
    beside its center (see `flow_position`). A highlight comes before an
    image on the same line.
    """
    import pymupdf

    def center(box):
        return (box[0] + box[2]) / 2, (box[1] + box[3]) / 2

    found = []  # (page, flow position, 0 for a highlight or 1 for an image, content)
    flows = {}
    ignored: dict[str, int] = {}
    with pymupdf.open(path) as doc:
        for page in doc:
            highlights = []
            for annot in page.annots():
                kind = annot.type[1]
                if kind == "Highlight":
                    v = annot.vertices or []
                    highlights.append((v, pymupdf.Quad(v[:4]).rect if len(v) >= 4 else annot.rect))
                elif not (kind == "Stamp" and annot.info["name"] == SUPERNOTE_INK) and kind != "Popup":
                    ignored[kind] = ignored.get(kind, 0) + 1
            # Text extraction includes what annotations draw, so the page
            # loses them first, in memory only.
            for xref in [a.xref for a in page.annots()]:
                page.delete_annot(page.load_annot(xref))
            flow = flows[page.number + 1] = text_flow(page)
            for v, first in highlights:
                found.append((page.number + 1, flow_position(flow, *center(first)), 0, highlighted_text(page, v)))
    if ignored:
        kinds = ", ".join(f"{n} {k}" for k, n in sorted(ignored.items()))
        log(job, f"'{path.name}': left out annotations of unsupported types ({kinds})")
    for page, box, png in handwriting_images(path):
        found.append((page, flow_position(flows[page], *center(box)), 1, png))
    # A stable sort, so annotations at the same place keep the order they were found in.
    found.sort(key=lambda a: a[:3])
    return [(page, content) for page, _, _, content in found]


def write_note(
    cfg: Config, template: str, job: str, item: dict, pdf: Path, attachment_key: str | None, force: bool
) -> Path | None:
    """Write the literature note for `item` from its annotated PDF `pdf`.

    Each highlight links to its page in the Zotero attachment
    `attachment_key`; with None, highlights give the page without a link.
    Each handwriting image is named after the note, with its own identifier:
    the next second after the note's that no other file uses. Identifiers
    and per-page numbers follow the images' order in the note.

    Return the note's path, or None if the item already has a note and
    `force` is false. With `force`, the existing note and the images it
    embeds are replaced, and the note keeps its filename. An existing note
    is recognized by the Zotero link in its front matter.
    """
    fields = paper_fields(item)
    keywords = denote_keywords(item, cfg.pipeline_tags)
    fields["tags"] = json.dumps(keywords)  # a YAML flow sequence, as Denote writes it
    existing = find_note(cfg.notes_dir, item["key"])
    if existing and not force:
        return None
    if existing:
        path = existing
        m = DENOTE_ID.match(existing.name)
        if not m:
            raise NoteError(f"note {existing.name} has no Denote identifier at the start of its name")
        identifier = m.group()
    else:
        start = datetime.strptime(f"{fields['date']} 09:00:00", "%Y-%m-%d %H:%M:%S")
        (identifier,) = free_identifiers(start, 1, taken_identifiers(cfg.notes_dir, cfg.images_dir))
        suffix = "__" + "_".join(keywords) if keywords else ""
        path = cfg.notes_dir / f"{identifier}==refs--{note_slug(fields)}{suffix}.md"

    entries = read_annotations(job, pdf)
    if attachment_key is None and any(isinstance(content, str) for _, content in entries):
        log(job, f"no Zotero attachment key for '{pdf.name}'; highlights are not linked to Zotero")

    def cite(page: int) -> str:
        if attachment_key is None:
            return f"p. {page}"
        return f"[p. {page}](zotero://open-pdf/library/items/{attachment_key}?page={page})"

    cfg.images_dir.mkdir(parents=True, exist_ok=True)
    if existing:
        for old in ANNOTATION_EMBED.findall(existing.read_text()):
            (cfg.images_dir / old).unlink(missing_ok=True)
    taken = taken_identifiers(cfg.notes_dir, cfg.images_dir) | {identifier}
    start = datetime.strptime(identifier, "%Y%m%dT%H%M%S") + timedelta(seconds=1)
    image_ids = iter(free_identifiers(start, sum(isinstance(c, bytes) for _, c in entries), taken))
    blocks = []
    per_page: dict[int, int] = {}
    for page, content in entries:
        if isinstance(content, str):
            blocks.append(f"> {content} ({cite(page)})")
            continue
        per_page[page] = per_page.get(page, 0) + 1
        name = annotation_name(path, next(image_ids), page, per_page[page])
        (cfg.images_dir / name).write_bytes(content)
        blocks.append(f"![[{name}]]")

    fields |= {"identifier": identifier, "annotations": "\n\n".join(blocks)}
    _atomic_write(path, render_template(template, fields))
    return path


def fetch_item(zot, key: str) -> dict:
    try:
        return zot.item(key)
    except Exception as e:
        raise NoteError(f"can't read item {key} from Zotero's local API: {e}") from e


def notes_ready(cfg: Config, job: str) -> str:
    """Check that notes can be written and return the template."""
    if not cfg.notes:
        fail(job, "no notes folder is configured; set `notes` with `nomada config`")
    if not cfg.notes_dir.is_dir():
        fail(job, f"notes folder not found: {cfg.notes_dir}")
    return load_template(cfg)


def annotated_pdf(cfg: Config, zot, key: str) -> tuple[str, Path]:
    """The key and stored file of the most recently added annotated attachment of item `key`."""
    try:
        children = zot.children(key)
    except Exception as e:
        raise NoteError(f"can't list attachments of item {key}: {e}") from e
    copies = [
        ch for ch in children
        if ch["data"].get("contentType") == "application/pdf" and is_annotated(cfg, ch["data"])
    ]
    if not copies:
        raise NoteError(f"item {key} has no annotated PDF")
    latest = max(copies, key=lambda ch: ch["data"].get("dateAdded", ""))
    path = cfg.storage_dir / latest["key"] / (latest["data"].get("filename") or "")
    if not path.is_file():
        raise NoteError(f"the annotated PDF of item {key} is not in {cfg.storage_dir} (has Zotero synced it?)")
    return latest["key"], path


# ---------------------------------------------------------------------------
# Jobs. Each returns the number of papers that hit a problem; problems that
# prevent the whole job from running raise click.ClickException instead.
# ---------------------------------------------------------------------------

def run_push(cfg: Config) -> int:
    job = "push"
    if not cfg.inbox_dir.is_dir():
        fail(job, f"INBOX folder not found: {cfg.inbox_dir} (is the synced drive available?)")
    zot = local_zotero()
    try:
        queued = zot.everything(zot.top(tag=cfg.tag_new))
    except Exception as e:
        fail(job, f"can't query Zotero's local API (is Zotero running, with local API access enabled?): {e}")

    state = load_state()
    fmap = state["map"]
    failures = copied = 0
    for item in queued:
        key = item["key"]
        try:
            children = zot.children(key)
        except Exception as e:
            log(job, f"can't list attachments of item {key}: {e}", error=True)
            failures += 1
            continue

        originals = [
            ch for ch in children
            if ch["data"].get("contentType") == "application/pdf"
            and ch["data"].get("linkMode") in ("imported_file", "imported_url")
            and ch["data"].get("filename")
            and not is_annotated(cfg, ch["data"])
        ]
        if not originals:
            log(job, f"item {key} is tagged '{cfg.tag_new}' but has no stored PDF", error=True)
            failures += 1
            continue
        if len(originals) > 1:
            keys = ", ".join(o["key"] for o in originals)
            log(job, f"item {key} has {len(originals)} stored PDFs ({keys}); keep one or attach the others as links", error=True)
            failures += 1
            continue

        ch = originals[0]
        fname = ch["data"]["filename"]
        src = cfg.storage_dir / ch["key"] / fname
        if not src.exists():
            log(job, f"stored file for item {key} is missing: {src}", error=True)
            failures += 1
            continue
        # `pull` matches exports to items by filename alone.
        if fmap.get(fname, key) != key:
            log(job, f"'{fname}' (item {key}) has the same filename as in-flight item {fmap[fname]}; rename one of them", error=True)
            failures += 1
            continue

        fmap[fname] = key
        dst = cfg.inbox_dir / fname
        if not dst.exists():
            shutil.copy2(src, dst)
            copied += 1
            log(job, f"-> INBOX  {fname}  (item {key})")

        try:
            set_pipeline_state(cfg, key, cfg.tag_inreview)
        except WriteError as e:
            log(job, f"can't tag item {key} '{cfg.tag_inreview}': {e}", error=True)
            failures += 1

    save_state(state)
    log(job, f"copied {copied} paper(s) to INBOX", persist=copied > 0)
    return failures


def run_pull(cfg: Config) -> int:
    job = "pull"
    if not cfg.export_dir.is_dir():
        fail(job, f"EXPORT folder not found: {cfg.export_dir} (is the synced drive available?)")
    if not cfg.inbox_dir.is_dir():
        fail(job, f"INBOX folder not found: {cfg.inbox_dir} (is the synced drive available?)")
    template = notes_ready(cfg, job) if cfg.note_on_pull else None
    cfg.processed_dir.mkdir(exist_ok=True)
    cfg.archive_dir.mkdir(exist_ok=True)

    state = load_state()
    fmap = state["map"]
    failures = imported = unmatched = 0
    for pdf in sorted(cfg.export_dir.glob("*.pdf")):
        name = pdf.name
        key = fmap.get(name)
        # Exports that `push` did not send (e.g. notebooks) are not ours to handle.
        if not key:
            unmatched += 1
            continue

        age = time.time() - pdf.stat().st_mtime
        if age < SETTLE_SECONDS:
            log(job, f"'{name}' changed {age:.0f} s ago and may still be syncing; skipped", persist=False)
            continue
        if not is_complete_pdf(pdf):
            log(job, f"'{name}' has no PDF end-of-file marker; it may be truncated", error=True)
            failures += 1
            continue

        try:
            att_key = attach(cfg, key, pdf)
        except WriteError as e:
            log(job, f"can't attach '{name}' to item {key}: {e}", error=True)
            failures += 1
            continue
        log(job, f"<- EXPORT {name}  (item {key}, {cfg.write_backend}: {att_key or 'no attachment key returned'})")
        imported += 1

        # The attachment exists now, so the files move on even if tagging
        # fails; otherwise the next pull would attach the same PDF again.
        try:
            set_pipeline_state(cfg, key, cfg.tag_reviewed)
        except WriteError as e:
            log(job, f"can't tag item {key} '{cfg.tag_reviewed}': {e}", error=True)
            failures += 1

        inbox_file = cfg.inbox_dir / name
        if inbox_file.exists():
            move_unique(inbox_file, cfg.archive_dir)
        processed = move_unique(pdf, cfg.processed_dir)
        del fmap[name]
        save_state(state)

        if template is not None:
            try:
                note = write_note(cfg, template, job, fetch_item(local_zotero(), key), processed, att_key, force=False)
            except (NoteError, OSError) as e:
                log(job, f"can't write the note for item {key} (retry with `nomada note {key}`): {e}", error=True)
                failures += 1
                continue
            if note:
                log(job, f"-> note  {note.name}")
            else:
                log(job, f"item {key} already has a note; left it unchanged")

    if unmatched:
        log(job, f"skipped {unmatched} PDF(s) in EXPORT that match no pushed paper; see `nomada status`", persist=False)
    log(job, f"imported {imported} annotated paper(s) into Zotero", persist=imported > 0)
    return failures


def run_note(cfg: Config, keys: tuple[str, ...], force: bool) -> int:
    job = "note"
    template = notes_ready(cfg, job)
    zot = local_zotero()
    if not keys:
        try:
            keys = tuple(item["key"] for item in zot.everything(zot.top(tag=cfg.tag_reviewed)))
        except Exception as e:
            fail(job, f"can't query Zotero's local API (is Zotero running, with local API access enabled?): {e}")

    failures = written = skipped = 0
    for key in keys:
        try:
            item = fetch_item(zot, key)
            att_key, pdf = annotated_pdf(cfg, zot, key)
            note = write_note(cfg, template, job, item, pdf, att_key, force)
        except (NoteError, OSError) as e:
            log(job, f"can't write the note for item {key}: {e}", error=True)
            failures += 1
            continue
        if note:
            log(job, f"-> note  {note.name}  (item {key})")
            written += 1
        else:
            skipped += 1
    if skipped:
        log(job, f"skipped {skipped} item(s) that already have a note; use --force to replace them", persist=False)
    log(job, f"wrote {written} note(s)", persist=written > 0)
    return failures


def is_complete_pdf(path: Path) -> bool:
    """True if the file's last KiB holds the PDF end-of-file marker."""
    with path.open("rb") as f:
        f.seek(0, os.SEEK_END)
        f.seek(max(0, f.tell() - 1024))
        return b"%%EOF" in f.read()


def move_unique(src: Path, dest_dir: Path) -> Path:
    """Move `src` into `dest_dir`, adding a timestamp to the name if it is taken."""
    dest = dest_dir / src.name
    if dest.exists():
        stamp = datetime.now().strftime("%Y%m%dT%H%M%S")
        dest = dest_dir / f"{src.stem} {stamp}{src.suffix}"
        if dest.exists():
            raise FileExistsError(f"can't move {src}: {dest} already exists")
    shutil.move(src, dest)
    return dest


def finish(failures: int) -> None:
    if failures:
        raise click.ClickException(f"{failures} paper(s) need attention; see the messages above or {LOG_FILE}")


# ---------------------------------------------------------------------------
# Command-line interface
# ---------------------------------------------------------------------------

@click.group(context_settings={"help_option_names": ["-h", "--help"]})
@click.version_option(__version__, "--version", prog_name=APP)
def cli() -> None:
    """Move papers between Zotero and a SuperNote Nomad.

    Tag a paper in Zotero with your "new" tag and run `nomada push` to send its
    PDF to the SuperNote INBOX folder. After exporting the annotated PDF on the
    Nomad, run `nomada pull` to attach it to the original Zotero item, and
    `nomada note` to write a literature note from its annotations.

    \b
    Examples:
      nomada config     # first-time setup
      nomada status     # check folders and Zotero connectivity
      nomada sync       # pull annotated papers, then push new ones
    """


@cli.command()
def config() -> None:
    """Prompt for settings and save them to the config file.

    Current values are offered as defaults. The file lives at
    $XDG_CONFIG_HOME/nomada/config.toml (~/.config/nomada/config.toml).
    """
    if not sys.stdin.isatty():
        raise click.ClickException("`nomada config` is interactive; run it in a terminal")
    current = {}
    if CONFIG_FILE.exists():
        raw = read_config_file()
        current = {k: v for k, v in raw.items() if k in FIELDS and isinstance(v, FIELD_TYPES[k])}
        dropped = sorted(set(raw) - set(current))
        if dropped:
            click.echo(f"warning: dropping unknown or mistyped keys: {', '.join(dropped)}", err=True)
        click.echo(f"Updating {CONFIG_FILE}", err=True)
    else:
        click.echo(f"Creating {CONFIG_FILE}", err=True)

    def ask(name: str, text: str, fallback: str | None = None, **kwargs):
        default = current.get(name, FIELDS[name].default)
        if default is dataclasses.MISSING:
            default = fallback
        return click.prompt(text, default=default, **kwargs)

    values = {}
    values["inbox"] = ask("inbox", "SuperNote INBOX folder", value_proc=_existing_dir)
    values["export"] = ask("export", "SuperNote EXPORT folder", value_proc=_existing_dir,
                           fallback=str(Path(values["inbox"]).parent / "EXPORT"))
    values["zotero_storage"] = ask("zotero_storage", "Zotero storage folder", value_proc=_existing_dir)
    values["write_backend"] = ask("write_backend", "Attach annotated PDFs with", type=click.Choice(BACKENDS))
    if values["write_backend"] == "webapi":
        values["zotero_user_id"] = ask("zotero_user_id", "Zotero user ID (zotero.org/settings/keys)")
        values["zotero_api_key"] = ask("zotero_api_key", "Zotero API key with write access", hide_input=True)
    else:
        values["zotero_user_id"] = current.get("zotero_user_id", "")
        values["zotero_api_key"] = current.get("zotero_api_key", "")
    values["annotated_title"] = ask("annotated_title", "Title of the annotated attachment")
    values["annotated_suffix"] = ask("annotated_suffix", "Suffix added to the annotated filename")
    values["tag_new"] = ask("tag_new", "Tag that queues a paper for the Nomad")
    values["tag_inreview"] = ask("tag_inreview", "Tag for papers on the Nomad")
    values["tag_reviewed"] = ask("tag_reviewed", "Tag for papers with an annotated copy")
    values["notes"] = ask("notes", "Folder for literature notes (empty for none)", value_proc=_optional_dir)
    if values["notes"]:
        values["note_images"] = ask("note_images", "Folder for note images (empty for the notes folder)",
                                    value_proc=_optional_dir)
        values["note_template"] = ask("note_template", "Note template file (empty for the built-in one)",
                                      value_proc=_optional_file)
        values["note_on_pull"] = click.confirm("Write a note for each paper `pull` imports?",
                                               default=current.get("note_on_pull", False))
    else:
        values["note_on_pull"] = False
        for name in ("note_images", "note_template"):
            values[name] = current.get(name, "")

    cfg = Config(**values)
    problems = validate(cfg)
    if problems:
        details = "".join(f"\n  - {p}" for p in problems)
        raise click.ClickException(f"configuration not saved:{details}")
    save_config(cfg)
    click.echo(f"Saved {CONFIG_FILE}. Run `nomada status` to check the setup.", err=True)


@cli.command()
def push() -> None:
    """Copy papers tagged "new" in Zotero to the SuperNote INBOX."""
    cfg = load_config()
    with state_lock():
        finish(run_push(cfg))


@cli.command()
def pull() -> None:
    """Attach annotated PDFs from the SuperNote EXPORT folder to their Zotero items."""
    cfg = load_config()
    with state_lock():
        finish(run_pull(cfg))


@cli.command()
@click.argument("item_keys", nargs=-1)
@click.option("--force", is_flag=True, help="Replace existing notes and their images.")
def note(item_keys: tuple[str, ...], force: bool) -> None:
    """Write literature notes for papers tagged "reviewed".

    A note holds the paper's highlighted passages and an image of each group
    of handwritten marks, read from its annotated PDF in Zotero storage. With
    ITEM_KEYS, only those Zotero items get notes. Papers that already have a
    note are skipped unless --force is given.
    """
    cfg = load_config()
    finish(run_note(cfg, item_keys, force))


@cli.command()
def sync() -> None:
    """Run `pull`, then `push`."""
    cfg = load_config()
    with state_lock():
        finish(run_pull(cfg) + run_push(cfg))


@cli.command()
def status() -> None:
    """Show configuration, folder contents, and Zotero connectivity.

    Exits with status 1 if anything that push or pull needs is missing.
    """
    ok = True
    rows: list[tuple[str, str]] = [
        ("version", __version__),
        ("config", str(CONFIG_FILE)),
        ("state", str(STATE_FILE)),
        ("log", str(LOG_FILE)),
    ]

    def show() -> None:
        width = max(len(k) for k, _ in rows)
        for k, v in rows:
            click.echo(f"{k:<{width}}  {v}")

    if not CONFIG_FILE.exists():
        rows.append(("setup", "not configured; run `nomada config`"))
        show()
        sys.exit(1)
    cfg = load_config()
    rows.append(("backend", cfg.write_backend))

    for label, d in (("INBOX", cfg.inbox_dir), ("EXPORT", cfg.export_dir)):
        if d.is_dir():
            rows.append((label, f"{d}  ({len(list(d.glob('*.pdf')))} PDF(s))"))
        else:
            rows.append((label, f"{d}  (MISSING)"))
            ok = False
    if not cfg.storage_dir.is_dir():
        rows.append(("storage", f"{cfg.storage_dir}  (MISSING)"))
        ok = False
    if cfg.notes:
        missing = "" if cfg.notes_dir.is_dir() else "  (MISSING)"
        on_pull = "written on pull" if cfg.note_on_pull else "written by `nomada note`"
        rows.append(("notes", f"{cfg.notes_dir}{missing}  ({on_pull})"))
        ok = ok and not missing
    fmap = load_state()["map"]
    rows.append(("in flight", f"{len(fmap)} paper(s) pushed and not yet pulled"))
    # Listed after the table; neither affects the exit status.
    lists: list[tuple[str, list[str]]] = []
    if cfg.inbox_dir.is_dir():
        gone = sorted(n for n in fmap if not (cfg.inbox_dir / n).exists())
        lists.append(("In flight but no longer in INBOX", gone))
    if cfg.export_dir.is_dir():
        unmatched = sorted(p.name for p in cfg.export_dir.glob("*.pdf") if p.name not in fmap)
        lists.append(("PDFs in EXPORT that match no pushed paper", unmatched))

    try:
        zot = local_zotero()
        counts = [f"{t}: {len(zot.everything(zot.top(tag=t)))}" for t in cfg.pipeline_tags]
        rows.append(("local API", "reachable"))
        rows.append(("tags", ", ".join(counts)))
    except Exception as e:
        rows.append(("local API", f"NOT reachable ({e})"))
        ok = False

    # Tagging always needs the Local Write API add-on, whichever backend attaches.
    try:
        r = requests.get(f"{LOCAL_BASE}/version", timeout=10)
        r.raise_for_status()
        info = r.json()
        caps = info.get("capabilities", [])
        detail = f"version {info.get('version', '?')}"
        if cfg.write_backend == "localwrite" and "attach_bytes" not in caps:
            detail += ", missing the attach_bytes capability"
            ok = False
        rows.append(("Local Write API", detail))
    except (requests.RequestException, ValueError) as e:
        rows.append(("Local Write API", f"NOT reachable ({e})"))
        ok = False

    show()
    for title, names in lists:
        if names:
            click.echo(f"\n{title} ({len(names)}):")
            for n in names:
                click.echo(f"  {n}")
    if not ok:
        sys.exit(1)


if __name__ == "__main__":
    cli()
